# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/

# Environments
.venv/
venv/
env/

# Editors
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Paired notebooks: the .py files are the source of truth, the .ipynb are
# generated by jupytext and would otherwise churn the diff on every run.
notebooks/*.ipynb

# Where the protocol writes its results
results/

# The published getAxis, kept unchanged, writes "noname-axis.npy" into the
# working directory when it is not given a name. The picker and api.medial_axis
# never call it that way; this catches a direct call.
/noname-*.npy
/*-axis.npy

# Figures are outputs, not sources
figures/
*.svg

# Local working notes, never published
inbox/
